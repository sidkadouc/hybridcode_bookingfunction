                  },
                  {
                    "operator": "==",
                    "thresholdValue": "TopicStart",
                    "representation": "turquoise",
                    "text": "Topic Start"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "TopicEnd",
                    "representation": "gray",
                    "text": "Topic End"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "TopicAction",
                    "representation": "orange",
                    "text": "Topic Action"
                  },
                  {
                    "operator": "Default",
                    "representation": "gray",
                    "text": "{0}"
                  }
                ]
              }
            },
            {
              "columnMatch": "Content",
              "formatter": 1,
              "formatOptions": {
                "customColumnWidthSetting": "400px"
              }
            },
            {
              "columnMatch": "Moderation",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "BLOCKED",
                    "representation": "redBright",
                    "text": "BLOCKED"
                  },
                  {
                    "operator": "==",
